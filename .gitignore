# See https://git-scm.com/docs/gitignore for pattern syntax and precedence.

# Dependencies are restored from the package manifest and lockfile.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test output and local coverage reports.
/coverage

# Next.js build output and static export output.
/.next/
/out/

# Other build directories produced by tools or deployment adapters.
/build
/.turbo

# Operating-system and editor metadata.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local certificates and private keys must never be committed.
*.pem

# Logs and local debug output.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files may contain API keys and deployment credentials.
.env*

# Vercel deployment metadata.
.vercel

# TypeScript and ESLint caches are generated locally.
*.tsbuildinfo
.eslintcache
next-env.d.ts
